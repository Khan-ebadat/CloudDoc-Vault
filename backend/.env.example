# AWS CloudDoc Vault Backend Environment Variables
AWS_REGION=us-east-1
USERS_TABLE_NAME=ClouddocUsers
DOCUMENTS_TABLE_NAME=DocumentsMetadata
DOCUMENTS_BUCKET_NAME=clouddoc-vault-documents-123456789012-us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:CloudDocVault_Events
JWT_SECRET=replace_with_a_long_random_secret_at_deploy_time
